#!/usr/bin/env python3
"""Send Codex, Claude Code, and shell task events to Windows from WSL."""

from __future__ import annotations

import base64
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
from typing import Any


APP_NAME = "Agent Notify"
APP_ID = "ZhangZhuorui.AgentNotify"
VERSION = "0.2.1"
DEFAULT_MESSAGE = "任务已完成"
POWERSHELL_PATHS = (
    "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
    "powershell.exe",
)
LEVELS = {
    "info": ("Information", "Info", ""),
    "warning": ("Warning", "Warning", "警告"),
    "error": ("Error", "Error", "错误"),
}


def compact(value: object, limit: int) -> str:
    text = " ".join(str(value or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def project_name(cwd: object) -> str:
    path = os.path.normpath(str(cwd or ""))
    return os.path.basename(path) or path or "Agent"


def parse_agent_event(source: str, data: dict[str, Any]) -> tuple[str, str, str] | None:
    if source == "codex":
        if data.get("type") != "agent-turn-complete":
            return None
        agent = "Codex"
        message = data.get("last-assistant-message")
    elif source in {"codex-hook", "claude"}:
        if data.get("hook_event_name") != "Stop":
            return None
        agent = "Codex" if source == "codex-hook" else "Claude Code"
        message = data.get("last_assistant_message")
    else:
        raise ValueError(f"unsupported source: {source}")

    title = f"{agent} · {project_name(data.get('cwd'))}"
    return compact(title, 64), compact(message, 240) or DEFAULT_MESSAGE, "info"


def parse_generic_event(data: dict[str, Any]) -> tuple[str, str, str]:
    source = compact(data.get("source"), 24) or APP_NAME
    project = compact(data.get("project"), 32)
    fallback_title = f"{source} · {project}" if project else source
    title = compact(data.get("title") or fallback_title, 64)
    message = compact(data.get("message"), 240) or DEFAULT_MESSAGE
    level = str(data.get("level") or "info").lower()
    if level not in LEVELS:
        raise ValueError("level must be info, warning, or error")
    return title, message, level


def find_powershell() -> str:
    configured = os.environ.get("AGENT_NOTIFY_POWERSHELL")
    if configured:
        return configured
    for candidate in POWERSHELL_PATHS:
        if os.path.isabs(candidate) and os.path.isfile(candidate):
            return candidate
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    raise FileNotFoundError("Windows PowerShell was not found; run this command inside WSL")


def find_icon() -> Path:
    script = Path(__file__).resolve()
    candidates = (
        script.parent / "assets/agent-notify.png",
        script.parent.parent / "share/agent-notify/agent-notify.png",
    )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("agent-notify.png was not found; run install.sh again")


def powershell_command(title: str, message: str, level: str, duration_ms: int) -> str:
    title64 = base64.b64encode(title.encode()).decode()
    message64 = base64.b64encode(message.encode()).decode()
    system_icon, balloon_icon, attribution = LEVELS[level]
    attribution64 = base64.b64encode(attribution.encode()).decode()
    return rf"""
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$title = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{title64}'))
$message = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{message64}'))
$attribution = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{attribution64}'))
$identityKey = 'HKCU:\Software\Classes\AppUserModelId\{APP_ID}'
if (Test-Path $identityKey) {{
    try {{
        [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType=WindowsRuntime] | Out-Null
        [Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType=WindowsRuntime] | Out-Null
        $titleXml = [Security.SecurityElement]::Escape($title)
        $messageXml = [Security.SecurityElement]::Escape($message)
        $attributionXml = if ($attribution) {{
            "<text placement='attribution'>$([Security.SecurityElement]::Escape($attribution))</text>"
        }} else {{ '' }}
        $payload = "<toast><visual><binding template='ToastGeneric'><text hint-maxLines='1'>$titleXml</text><text>$messageXml</text>$attributionXml</binding></visual></toast>"
        $document = New-Object Windows.Data.Xml.Dom.XmlDocument
        $document.LoadXml($payload)
        $toast = [Windows.UI.Notifications.ToastNotification]::new($document)
        [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('{APP_ID}').Show($toast)
        Start-Sleep -Milliseconds 250
        exit 0
    }} catch {{
        # The WinForms balloon below keeps notifications available on older systems.
    }}
}}
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
$notification = New-Object System.Windows.Forms.NotifyIcon
$notification.Icon = [System.Drawing.SystemIcons]::{system_icon}
$notification.BalloonTipIcon = [System.Windows.Forms.ToolTipIcon]::{balloon_icon}
$notification.BalloonTipTitle = $title
$notification.BalloonTipText = $message
$notification.Visible = $true
$notification.ShowBalloonTip({duration_ms})
Start-Sleep -Milliseconds {duration_ms + 500}
$notification.Dispose()
"""


def windows_setup_command(icon: bytes) -> str:
    icon64 = base64.b64encode(icon).decode()
    return rf"""
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$directory = Join-Path $env:LOCALAPPDATA '{APP_NAME}'
$iconPath = Join-Path $directory 'agent-notify.png'
New-Item -ItemType Directory -Path $directory -Force | Out-Null
[IO.File]::WriteAllBytes($iconPath, [Convert]::FromBase64String('{icon64}'))
$key = 'HKCU:\Software\Classes\AppUserModelId\{APP_ID}'
New-Item -Path $key -Force | Out-Null
New-ItemProperty -Path $key -Name DisplayName -Value '{APP_NAME}' -PropertyType ExpandString -Force | Out-Null
New-ItemProperty -Path $key -Name IconUri -Value $iconPath -PropertyType ExpandString -Force | Out-Null
New-ItemProperty -Path $key -Name IconBackgroundColor -Value 'FF4338CA' -PropertyType String -Force | Out-Null
Write-Output "configured Windows app identity: $key"
"""


def windows_remove_command() -> str:
    return rf"""
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try {{
    [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType=WindowsRuntime] | Out-Null
    [Windows.UI.Notifications.ToastNotificationManager]::History.Clear('{APP_ID}')
}} catch {{}}
$key = 'HKCU:\Software\Classes\AppUserModelId\{APP_ID}'
$directory = Join-Path $env:LOCALAPPDATA '{APP_NAME}'
Remove-Item -Path $key -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item -Path $directory -Recurse -Force -ErrorAction SilentlyContinue
Write-Output "removed Windows app identity: $key"
"""


def run_powershell(command: str, *, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            find_powershell(),
            "-NoProfile",
            "-NonInteractive",
            "-WindowStyle",
            "Hidden",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            command,
        ],
        check=False,
        text=True,
        capture_output=capture,
    )


def notify(
    title: str,
    message: str,
    level: str = "info",
    *,
    wait: bool = False,
    duration_ms: int = 5000,
) -> int:
    duration_ms = max(1000, min(duration_ms, 30000))
    command = [
        find_powershell(),
        "-NoProfile",
        "-NonInteractive",
        "-WindowStyle",
        "Hidden",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        powershell_command(compact(title, 64), compact(message, 240), level, duration_ms),
    ]
    if wait:
        return subprocess.run(command, check=False).returncode
    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return 0


def state_dir() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "agent-notify"


def log_error(error: Exception) -> None:
    try:
        directory = state_dir()
        directory.mkdir(parents=True, exist_ok=True)
        with (directory / "errors.log").open("a", encoding="utf-8") as log:
            log.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {type(error).__name__}: {error}\n")
    except OSError:
        pass


def log_event(source: str, title: str) -> None:
    try:
        directory = state_dir()
        directory.mkdir(parents=True, exist_ok=True)
        with (directory / "events.log").open("a", encoding="utf-8") as log:
            log.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {source} {title}\n")
    except OSError:
        pass


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode if path.exists() else 0o600
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as temp:
        temp.write(text)
        temp_path = Path(temp.name)
    os.chmod(temp_path, mode)
    os.replace(temp_path, path)


def backup(path: Path) -> None:
    destination = Path(f"{path}.agent-notify.backup")
    if path.exists() and not destination.exists():
        shutil.copy2(path, destination)


def setup_codex(command: str) -> None:
    config_path = Path.home() / ".codex/config.toml"
    if config_path.exists():
        text = config_path.read_text(encoding="utf-8")
        updated = re.sub(r"(?m)^notify\s*=.*agent-notify.*\n?", "", text, count=1)
        if updated != text:
            backup(config_path)
            atomic_write(config_path, updated)

    path = Path.home() / ".codex/hooks.json"
    data: dict[str, Any] = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    stop_hooks = data.setdefault("hooks", {}).setdefault("Stop", [])
    hook_command = f"{command} codex-hook"
    existing = next((
        hook
        for group in stop_hooks if isinstance(group, dict)
        for hook in group.get("hooks", [])
        if isinstance(hook, dict) and hook.get("command") == hook_command
    ), None)
    if existing:
        changed = existing.pop("async", None) is not None
        changed = existing.get("timeout") != 15 or changed
        existing["timeout"] = 15
        if not changed:
            print(f"Codex already configured: {path}")
            return
    else:
        stop_hooks.append({"hooks": [{
            "type": "command",
            "command": hook_command,
            "timeout": 15,
        }]})
    backup(path)
    atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    print(f"configured Codex: {path}")


def setup_claude(command: str) -> None:
    path = Path.home() / ".claude/settings.json"
    data: dict[str, Any] = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    stop_hooks = data.setdefault("hooks", {}).setdefault("Stop", [])
    hook_command = f"{command} claude"
    exists = any(
        isinstance(group, dict)
        and any(
            isinstance(hook, dict) and hook.get("command") == hook_command
            for hook in group.get("hooks", [])
        )
        for group in stop_hooks
    )
    if not exists:
        stop_hooks.append({"hooks": [{"type": "command", "command": hook_command, "async": True}]})
    else:
        print(f"Claude Code already configured: {path}")
        return
    backup(path)
    atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    print(f"configured Claude Code: {path}")


def setup_windows() -> None:
    result = run_powershell(windows_setup_command(find_icon().read_bytes()), capture=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Windows app identity setup failed")
    print(result.stdout.strip())


def setup(target: str) -> int:
    command = str(Path(sys.argv[0]).resolve())
    setup_windows()
    if target in {"codex", "all"}:
        setup_codex(command)
        print("Codex next step: restart the client, open /hooks, and trust the Agent Notify Stop hook.")
    if target in {"claude", "all"}:
        setup_claude(command)
    return 0


def remove_codex() -> None:
    config_path = Path.home() / ".codex/config.toml"
    if config_path.exists():
        text = config_path.read_text(encoding="utf-8")
        updated = re.sub(r"(?m)^notify\s*=.*agent-notify.*\n?", "", text, count=1)
        if updated != text:
            backup(config_path)
            atomic_write(config_path, updated)
    path = Path.home() / ".codex/hooks.json"
    if not path.exists():
        return
    data: dict[str, Any] = json.loads(path.read_text(encoding="utf-8"))
    stop_hooks = data.get("hooks", {}).get("Stop", [])
    changed = False
    for group in stop_hooks:
        hooks = group.get("hooks", []) if isinstance(group, dict) else []
        kept = [hook for hook in hooks if "agent-notify codex-hook" not in str(hook.get("command", ""))]
        if len(kept) != len(hooks):
            group["hooks"] = kept
            changed = True
    hooks_config = data.get("hooks")
    if isinstance(hooks_config, dict):
        hooks_config["Stop"] = [
            group for group in stop_hooks
            if isinstance(group, dict) and group.get("hooks")
        ]
    if changed:
        backup(path)
        atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
        print(f"removed Codex integration: {path}")


def remove_claude() -> None:
    path = Path.home() / ".claude/settings.json"
    if not path.exists():
        return
    data: dict[str, Any] = json.loads(path.read_text(encoding="utf-8"))
    stop_hooks = data.get("hooks", {}).get("Stop", [])
    changed = False
    for group in stop_hooks:
        hooks = group.get("hooks", []) if isinstance(group, dict) else []
        kept = [hook for hook in hooks if "agent-notify claude" not in str(hook.get("command", ""))]
        if len(kept) != len(hooks):
            group["hooks"] = kept
            changed = True
    hooks_config = data.get("hooks")
    if isinstance(hooks_config, dict):
        hooks_config["Stop"] = [
            group for group in stop_hooks
            if isinstance(group, dict) and group.get("hooks")
        ]
    if changed:
        backup(path)
        atomic_write(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
        print(f"removed Claude Code integration: {path}")


def remove_windows() -> None:
    result = run_powershell(windows_remove_command(), capture=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Windows app identity removal failed")
    print(result.stdout.strip())


def remove(target: str) -> int:
    cleanups = []
    if target in {"codex", "all"}:
        cleanups.append(("Codex", remove_codex))
    if target in {"claude", "all"}:
        cleanups.append(("Claude Code", remove_claude))
    if target in {"windows", "all"}:
        cleanups.append(("Windows", remove_windows))
    errors = []
    for name, cleanup in cleanups:
        try:
            cleanup()
        except Exception as error:
            errors.append(f"{name}: {error}")
    if errors:
        raise RuntimeError("cleanup failed — " + "; ".join(errors))
    return 0


def windows_identity_status() -> tuple[bool, str]:
    command = rf"""
$ProgressPreference = 'SilentlyContinue'
[Console]::OutputEncoding = [Text.UTF8Encoding]::new()
$key = 'HKCU:\Software\Classes\AppUserModelId\{APP_ID}'
if (!(Test-Path $key)) {{ Write-Output 'identity missing'; exit 2 }}
$identity = Get-ItemProperty -Path $key
if ($identity.DisplayName -ne '{APP_NAME}') {{ Write-Output 'display name invalid'; exit 3 }}
if (!(Test-Path $identity.IconUri)) {{ Write-Output "icon missing: $($identity.IconUri)"; exit 4 }}
Write-Output "$($identity.DisplayName) [{APP_ID}] — $($identity.IconUri)"
"""
    result = run_powershell(command, capture=True)
    detail = (result.stdout or result.stderr).strip()
    return result.returncode == 0, detail


def configured_hook(path: Path, action: str) -> str | None:
    if not path.exists():
        return None
    data = json.loads(path.read_text(encoding="utf-8"))
    suffix = f"agent-notify {action}"
    return next((
        command
        for group in data.get("hooks", {}).get("Stop", []) if isinstance(group, dict)
        for hook in group.get("hooks", []) if isinstance(hook, dict)
        if isinstance(command := hook.get("command"), str) and command.endswith(suffix)
    ), None)


def doctor() -> int:
    checks: list[tuple[str, bool, str]] = []
    try:
        powershell = find_powershell()
        checks.append(("Windows PowerShell", True, powershell))
    except FileNotFoundError as error:
        checks.append(("Windows PowerShell", False, str(error)))
    try:
        identity_okay, identity_detail = windows_identity_status()
        checks.append(("Windows app identity", identity_okay, identity_detail))
    except FileNotFoundError as error:
        checks.append(("Windows app identity", False, str(error)))
    codex_path = Path.home() / ".codex/hooks.json"
    claude_path = Path.home() / ".claude/settings.json"
    for name, okay, detail in checks:
        print(f"{'OK' if okay else 'WARN':4}  {name}: {detail}")
    for name, path, action in (
        ("Codex integration", codex_path, "codex-hook"),
        ("Claude Code integration", claude_path, "claude"),
    ):
        command = configured_hook(path, action)
        print(f"{'OK' if command else 'INFO':4}  {name}: {command or f'not configured — {path}'}")
    error_path = state_dir() / "errors.log"
    errors = error_path.read_text(encoding="utf-8").splitlines() if error_path.exists() else []
    error_detail = f"latest: {errors[-1]} — {error_path}" if errors else f"none recorded — {error_path}"
    print(f"INFO  Hook errors: {error_detail}")
    return 0 if all(check[1] for check in checks) else 1


def self_test() -> int:
    assert compact("  one\n two  ", 20) == "one two"
    assert project_name("/home/user/app") == "app"
    assert parse_agent_event("codex", {
        "type": "agent-turn-complete",
        "cwd": "/repo/app",
        "last-assistant-message": "Done",
    }) == ("Codex · app", "Done", "info")
    assert parse_agent_event("claude", {
        "hook_event_name": "Stop",
        "cwd": "/repo/app",
        "last_assistant_message": "Ready",
    }) == ("Claude Code · app", "Ready", "info")
    assert parse_agent_event("codex-hook", {
        "hook_event_name": "Stop",
        "cwd": "/repo/app",
        "last_assistant_message": "Ready",
    }) == ("Codex · app", "Ready", "info")
    assert parse_generic_event({"source": "Build", "project": "app", "message": "Failed", "level": "error"}) == ("Build · app", "Failed", "error")
    toast = powershell_command("Codex <build>", "完成 & ready", "warning", 5000)
    assert APP_ID in toast
    assert "ToastGeneric" in toast
    assert "SecurityElement]::Escape" in toast
    assert base64.b64encode("警告".encode()).decode() in toast
    assert APP_ID in windows_setup_command(b"png")
    assert base64.b64encode(b"png").decode() in windows_setup_command(b"png")
    assert APP_ID in windows_remove_command()
    hooks = {
        "hooks": {"Stop": [{"hooks": [{
            "type": "command",
            "command": "/home/user/.local/bin/agent-notify codex-hook",
        }]}]}
    }
    with tempfile.TemporaryDirectory() as directory:
        path = Path(directory) / "hooks.json"
        path.write_text(json.dumps(hooks), encoding="utf-8")
        assert configured_hook(path, "codex-hook") == "/home/user/.local/bin/agent-notify codex-hook"
        assert configured_hook(path, "claude") is None
    print("agent-notify self-test passed")
    return 0


def usage() -> int:
    print("""usage:
  agent-notify send TITLE MESSAGE [info|warning|error]
  agent-notify event                 # read a generic JSON event from stdin
  agent-notify run TITLE -- COMMAND [ARG ...]
  agent-notify codex JSON
  agent-notify codex-hook            # read Codex Stop hook JSON from stdin
  agent-notify claude                # read Claude hook JSON from stdin
  agent-notify setup windows|codex|claude|all
  agent-notify remove windows|codex|claude|all
  agent-notify test | doctor | self-test | version""", file=sys.stderr)
    return 2


def run_command(args: list[str]) -> int:
    if len(args) < 2:
        return usage()
    title = args[0]
    command = args[1:]
    if command[0] == "--":
        command = command[1:]
    if not command:
        return usage()
    started = time.monotonic()
    result = subprocess.run(command, check=False)
    elapsed = time.monotonic() - started
    level = "info" if result.returncode == 0 else "error"
    status = "完成" if result.returncode == 0 else f"失败（退出码 {result.returncode}）"
    notify(title, f"{status}，耗时 {elapsed:.1f} 秒", level)
    return result.returncode


def main() -> int:
    if len(sys.argv) < 2:
        return usage()
    action, args = sys.argv[1], sys.argv[2:]
    hook_action = action in {"codex", "codex-hook", "claude"}
    try:
        if action == "send" and len(args) in {2, 3}:
            level = args[2] if len(args) == 3 else "info"
            if level not in LEVELS:
                raise ValueError("level must be info, warning, or error")
            return notify(args[0], args[1], level)
        if action == "event":
            return notify(*parse_generic_event(json.load(sys.stdin)))
        if action == "run":
            return run_command(args)
        if action == "codex" and len(args) == 1:
            event = parse_agent_event("codex", json.loads(args[0]))
            if event:
                log_event(action, event[0])
            return notify(*event) if event else 0
        if action == "codex-hook":
            event = parse_agent_event("codex-hook", json.load(sys.stdin))
            if event:
                log_event(action, event[0])
            return notify(*event) if event else 0
        if action == "claude":
            event = parse_agent_event("claude", json.load(sys.stdin))
            if event:
                log_event(action, event[0])
            return notify(*event) if event else 0
        if action == "setup" and len(args) == 1 and args[0] in {"windows", "codex", "claude", "all"}:
            return setup(args[0])
        if action == "remove" and len(args) == 1 and args[0] in {"windows", "codex", "claude", "all"}:
            return remove(args[0])
        if action == "test":
            result = notify(f"{APP_NAME} · 测试", "Windows 通知功能运行正常", wait=True)
            if result == 0:
                print("Notification sent. Check the banner or press Win+N to open Notification Center.")
            return result
        if action == "doctor":
            return doctor()
        if action == "self-test":
            return self_test()
        if action in {"version", "--version"}:
            print(f"{APP_NAME} {VERSION}")
            return 0
        return usage()
    except Exception as error:
        log_error(error)
        if hook_action:
            return 0
        print(f"agent-notify: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
